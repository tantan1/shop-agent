# 本机一键部署环境变量（复制为 local.env 后按需修改）
# 用法：cp local.env.example local.env && ./apply-local.sh
#
# 集群类型：docker-desktop（Docker Desktop 自带 K8s）/ minikube / kind
# 默认 docker-desktop（Windows/Mac 最常用）。

# ---- 镜像 ----
# 本机不推 OCIR，直接 docker build 后加载进集群；IMAGE_PREFIX 留空（末尾含斜杠，OKE 用 ${OCIR_REGISTRY}/）。
IMAGE_PREFIX=""
IMAGE_TAG="local"
# 本机镜像策略：Always 本地有就用本地（配合 kind load / minikube 自带 docker）
IMAGE_PULL_POLICY="IfNotPresent"

# ---- 存储 ----
# 本机集群默认 StorageClass：docker-desktop/minikube/kind 都自带 "standard"
STORAGE_CLASS="standard"

# ---- 入口 ----
# 本机用 localhost + 端口转发访问，无需真实域名
INGRESS_HOST="localhost"

# ---- 对象存储（本机无 OCI Object Storage）----
# 留空：应用侧 S3 客户端会自动降级（Langfuse 可能起不来，属预期）
S3_ENDPOINT=""
OCI_REGION="local"
AWS_ACCESS_KEY_ID="local"
AWS_SECRET_ACCESS_KEY="local"

# ---- 占位密钥（本机演示用，生产务必替换）----
REDIS_AUTH="local-redis-password"
POSTGRES_PASSWORD="local-postgres-password"
OPENAI_API_KEY="sk-local-placeholder"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
FIXED_API_KEY="local-fixed-key"
LANGFUSE_INIT_USER_PASSWORD="local-langfuse-password"
GRAFANA_API_KEY="local-grafana-token"
LANGFUSE_PUBLIC_KEY="pk-local-placeholder"
LANGFUSE_SECRET_KEY="sk-local-placeholder"

# ---- Mock LLM + 限流（压测用）----
# LLM_ADAPTER_TYPE=mock 启用 MockLLM，否则使用真实 LLM（langchain/openai）
LLM_ADAPTER_TYPE="langchain"
# MockLLM 延迟范围（ms）
MOCK_LLM_LATENCY_MIN="50"
MOCK_LLM_LATENCY_MAX="100"
# MockLLM 错误率（0-1，0.01 = 1%）
MOCK_LLM_ERROR_RATE="0.01"
# MockLLM 单次输出 token 数
MOCK_LLM_OUTPUT_TOKENS="200"
# 速率限制（req/60s/IP），压测时调高以测真实吞吐
CHAT_RATE_LIMIT="50000"
GLOBAL_RATE_LIMIT="50000"

# ---- 数据库连接串（本机 Postgres 同源）----
# order-service 使用完整 DATABASE_URL
ORDER_DATABASE_URL="postgres://postgres:local-postgres-password@postgres:5432/order_service"
# langfuse 复用同一 Postgres，库名 langfuse
LANGFUSE_DATABASE_URL="postgres://postgres:local-postgres-password@postgres:5432/langfuse"
FULL=1
LOCAL_MODEL=1

# ---- 推理后端切换：ollama（k8s 内）| vllm（宿主机 Docker Desktop 的 vLLM）----
# 默认 vllm（宿主机 Docker Desktop 的 vLLM）；切回 k8s 内 Ollama 时改成 ollama。
# vllm 模式要求先 docker compose -f docker-compose.vllm.yml up -d 起好 vLLM。
LLM_BACKEND=vllm
# vLLM 宿主机地址（Docker Desktop 的 k8s 节点访问宿主机的入口）
# 若 host.docker.internal 在 Pod 内不通，改成 kubectl get nodes -o wide 的 INTERNAL-IP
VLLM_HOST=host.docker.internal
VLLM_QWEN3_PORT=8003
VLLM_BGE_M3_PORT=8101
VLLM_RERANKER_PORT=8102

# ---- shop-agent 模型配置 ----
# 主聊天大模型：走网关 → 百炼（需 TONGYI_API_KEY）
CHAT_MODEL="qwen3.7-plus-2026-05-26"
# 工具选择器 fallback 模型：本地 vLLM 别名（qwen3-unified），避免误走不存在的云端小模型
TOOL_SELECTOR_MODEL="qwen3-unified"
# 本地小模型后端：vllm（工具选择 / 参数抽取走本地 vLLM，无需云端 key）
LOCAL_MODEL_BACKEND="vllm"
VLLM_TOOL_SELECTOR_MODEL="qwen3-unified"

# ---- 百炼 / 通义真实 key（仅由 Gateway 持有，shop-agent 不再设置 LLM key）----
# 百炼与通义共用同一 key，统一用 TONGYI_API_KEY。下方 key 通过 app-secrets 注入 Gateway，
# shop-agent 经 LLM_GATEWAY_URL 调用时由网关兜底鉴权。
# 部署前请填入真实值，否则大模型（百炼）调用会鉴权失败。
TONGYI_API_KEY=""