# 统一镜像版本常量（单一来源，K8s 与 docker-compose 共用，消除版本漂移）
# 用法：
#   K8s:  apply-local.sh / deploy.yml 会 source 本文件后 envsubst 注入到清单
#   compose: docker compose 自动读取同名 .env（或 `set -a; source versions.env; docker compose up`）
#
# 版本对齐 docker-compose.yml 中已验证的固定值；redis/pgvector 已修正为正确镜像源。

# ---- 业务服务（本机由 docker build 生成，OCI 由 CI push 到 OCIR）----
IMAGE_PREFIX=""
IMAGE_TAG="local"
IMAGE_PULL_POLICY="IfNotPresent"

# ---- 核心中间件 ----
REDIS_IMAGE="redis/redis-stack-server:7.2.0-v14"          # 注意：必须 redis-stack（含 RediSearch VSS），裸 redis:7-alpine 会让向量缓存静默降级
PGVECTOR_IMAGE="pgvector/pgvector:0.8.2-pg18-trixie"
PROMETHEUS_IMAGE="prom/prometheus:v2.54.1"
ALERTMANAGER_IMAGE="prom/alertmanager:v0.26.0"
GRAFANA_IMAGE="grafana/grafana:11.3.0"
ETCD_IMAGE="quay.io/coreos/etcd:v3.5.25"
REGISTRY_IMAGE="registry:2"
LOKI_IMAGE="grafana/loki:3.1.0"
# 注：redaction processor 自 0.101.0 起才支持 logs（0.100.0 仅 traces，会报 "telemetry type is not supported"）
OTEL_AGENT_IMAGE="otel/opentelemetry-collector-contrib:0.110.0"
OTEL_GATEWAY_IMAGE="otel/opentelemetry-collector-contrib:0.110.0"

# ---- SkyWalking ----
SKYWALKING_BANYANDB_IMAGE="apache/skywalking-banyandb:0.8.0"
SKYWALKING_OAP_IMAGE="apache/skywalking-oap-server:10.2.0"
SKYWALKING_UI_IMAGE="apache/skywalking-ui:10.2.0"

# ---- 重组件（默认关闭）----
NEBULA_METAD_IMAGE="vesoft/nebula-metad:v3.8.0"
NEBULA_STORAGED_IMAGE="vesoft/nebula-storaged:v3.8.0"
NEBULA_GRAPHD_IMAGE="vesoft/nebula-graphd:v3.8.0"
LANGFUSE_IMAGE="langfuse/langfuse:3"
LANGFUSE_WORKER_IMAGE="langfuse/langfuse-worker:3"
MILVUS_IMAGE="milvusdb/milvus:v2.6.14"
CLICKHOUSE_IMAGE="clickhouse/clickhouse-server:latest"

# ---- compose 用的 Postgres 主版本 ----
POSTGRES_VERSION="17"
# ---- compose 仅用（K8s 不涉及）----
# 0.6.x+ 才支持 qwen3 架构（unified 1.7B GGUF）；0.5.1 会报 "unknown model architecture: 'qwen3'"
OLLAMA_IMAGE="ollama/ollama:0.32.5"
