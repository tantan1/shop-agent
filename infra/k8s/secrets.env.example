# K8s Secrets 配置文件
# 用法：cp secrets.env.example secrets.env && 编辑真实值
#       然后运行：./secrets.sh
#
# 格式：KEY=VALUE（每行一个，# 开头为注释）
# 未填写的字段会使用内置默认值（仅限本地开发）

# ── 数据库 ────────────────────────────────────────────────────────
REDIS_AUTH=
POSTGRES_PASSWORD=

# ── LLM 供应商 ────────────────────────────────────────────────────
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
FIXED_API_KEY=

# ── S3 / 对象存储 ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ── Langfuse ──────────────────────────────────────────────────────
LANGFUSE_INIT_USER_PASSWORD=

# ── 数据库连接串（使用默认值即可，修改密码后需同步更新） ──────────
# ORDER_DATABASE_URL=postgres://postgres:POSTGRES_PASSWORD@postgres:5432/order_service
# LANGFUSE_DATABASE_URL=postgres://postgres:POSTGRES_PASSWORD@postgres:5432/langfuse

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_API_KEY=
