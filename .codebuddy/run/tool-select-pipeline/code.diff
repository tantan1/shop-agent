+"""工具选择可配置迭代式 Pipeline 调用器。
+
+见 docs/architecture/tool-select-pipeline-design.md §5。
+维护 scope（下一层候选范围）与观测缓冲；统一做早停判断、候选软过滤传递与降级。
+各层 scored_candidates 仅用于观测日志，绝不参与跨层融合决策。
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+from typing import Any, Dict, List, Optional
+
+from src.modules.chat.core.tool_select_stage import CandidateScore, StageResult, ToolSelectStage
+from src.modules.chat.schemas import PlannedAction, ToolPlan
+
+logger = logging.getLogger(__name__)
+
+
+class ToolSelectPipeline:
+    def __init__(
+        self,
+        stages: List[ToolSelectStage],
+        thresholds: Dict[str, float],
+        all_tools: List[str],
+        deps: Dict[str, Any],
+        fallback: Optional[Dict[str, str]] = None,
+        timeouts: Optional[Dict[str, int]] = None,
+    ) -> None:
+        self.stages = stages
+        self.thresholds = thresholds
+        self._all_tools = list(all_tools)
+        self._deps = deps
+        self._fallback = fallback or {}
+        self._timeout_ms = timeouts or {}
+
+    async def select(self, query: str) -> ToolPlan:
+        scope: List[str] = list(self._all_tools)  # 当前候选 scope，传给各层
+        observations: List[CandidateScore] = []  # 各层打分，仅用于末尾观测日志
+        context = {"thresholds": self.thresholds, **self._deps}
+
+        for stage in self.stages:
+            try:
+                # 每层超时强制（来自配置 timeout_ms）：超时视为该层 error
+                timeout = self._timeout_ms.get(stage.name)
+                if timeout:
+                    result = await asyncio.wait_for(
+                        stage.run(query, scope, context), timeout=timeout / 1000
+                    )
+                else:
+                    result = await stage.run(query, scope, context)
+            except asyncio.TimeoutError:
+                result = StageResult(
+                    tool=None, confidence=0.0, source=stage.name, error="stage timeout"
+                )
+            except Exception as exc:  # 任何未捕获异常视为该层 error
+                result = StageResult(
+                    tool=None, confidence=0.0, source=stage.name, error=str(exc)
+                )
+
+            # 错误处理：按 fallback.on_stage_failure 策略
+            if result.error:
+                policy = self._fallback.get("on_stage_failure", "skip")
+                logger.warning(
+                    "tool_select_stage_error",
+                    extra={"stage": stage.name, "error": result.error},
+                )
+                if policy in ("abort", "hitl"):
+                    # hitl 在代码层等价于 need_llm：返回空结果交上游按部署处置
+                    return ToolPlan(actions=[], stop_condition="need_llm")
+                # policy == "skip"：继续下一层（本层不计入观测）
+            else:
+                # 累积本层打分（仅观测），并把下一层 scope 更新为软过滤结果
+                observations.extend(result.scored_candidates)
+                if result.scored_candidates:
+                    scope = [s.tool for s in result.scored_candidates]
+
+            # 早停：本层足够置信 → 直接返回，不触发更贵层级（成本漏斗）
+            if result.tool and result.confidence >= self.thresholds.get(stage.name, 0.9):
+                return ToolPlan(
+                    actions=[
+                        PlannedAction(
+                            name=result.tool,
+                            source=result.source,
+                            confidence=result.confidence,
+                        )
+                    ],
+                    source=result.source,
+                    stop_condition="plan_complete",
+                )
+
+        # 无层早停：不自行融合打分，按 fallback 策略降级（观测日志见下）
+        logger.info(
+            "tool_select_no_early_exit",
+            extra={
+                "observations": [
+                    (s.tool, round(s.score, 3), s.source) for s in observations
+                ]
+            },
+        )
+        return self._fallback_plan()
+
+    def _fallback_plan(self) -> ToolPlan:
+        """无层跨阈值时的降级结果；融合决策交由上游/策略，本方法不计算分数。"""
+        if self._fallback.get("on_all_stages_failed") == "default_tool" and self._all_tools:
+            return ToolPlan(
+                actions=[
+                    PlannedAction(name=self._all_tools[0], source="default", confidence=0.0)
+                ],
+                source="default",
+                stop_condition="plan_complete",
+            )
+        # 默认 need_llm：交上游按部署策略处置（云端 ReAct / HITL / 本地小模型）
+        return ToolPlan(actions=[], stop_condition="need_llm")
