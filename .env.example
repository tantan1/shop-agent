# ============================================================
# shop-agent 部署所需密钥 —— 全部通过 GitHub Secrets 注入 CI/CD
# 本地开发请勿把真实值写进此文件；本文件仅作变量清单。
# 部署文档：docs/oracle-cloud-deploy.md
# ============================================================

# ---- OCI / OCIR ----
OCI_REGION=ap-tokyo-1                       # OCI 区域
OCIR_REGISTRY=nrt.ocir.io/axaxkkk3z3jf      # OCIR 全限定域名 + 租户命名空间
OCI_TENANCY_NAMESPACE=axaxkkk3z3jf          # 租户对象存储命名空间
OCIR_USERNAME=axaxkkk3z3jf/oracleidentitycloudservice/user@domain.com  # OCIR 登录用户名
OCIR_AUTH_TOKEN=xxxxx                       # OCI 用户 Auth Token（非登录密码）
OCI_CLI_CONFIG=xxxxx                        # ~/.oci/config 完整内容（CI 用）
OCI_PRIVATE_KEY=xxxxx                       # OCI API 私钥 PEM（CI 用）
OKE_CLUSTER_ID=ocid1.cluster.xxxx           # OKE 集群 OCID

# ---- 业务密钥（注入 K8s Secret app-secrets）----
REDIS_AUTH=
POSTGRES_PASSWORD=
ORDER_DATABASE_URL=postgres://postgres:PASSWORD@postgres:5432/orders   # order-service 完整 DB URL（含密码，CI 注入 Secret）
LANGFUSE_DATABASE_URL=postgres://postgres:PASSWORD@postgres:5432/langfuse   # Langfuse 完整 DB URL（含密码）
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
FIXED_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
LANGFUSE_INIT_USER_PASSWORD=
GRAFANA_API_KEY=xxxxx                   # Grafana 服务账号 token（alert:write），monitoring-agent 推送 RCA 用

# ---- Ingress ----
INGRESS_HOST=api.yourdomain.com             # 对外域名（oci-ip 或自有域名）

# ---- GrowthBook（experiments profile，自托管实验后端；默认关闭，主流程零影响）----
# 仅在 docker compose --profile experiments 激活 GB/mongo 服务时设为 true。
GROWTHBOOK_ENABLED=
GROWTHBOOK_API_HOST=http://growthbook:3100
GROWTHBOOK_CLIENT_KEY=                       # 只读 SDK key（拉 features.json），首次启动 GB 后回填
GROWTHBOOK_DECRYPTION_KEY=                   # 解密 feature 定义（secret 注入，不落仓库）
GROWTHBOOK_API_KEY=                         # 服务端 REST（建/暂停实验），绝不进前端
GROWTHBOOK_CACHE_TTL=30
GROWTHBOOK_DATASOURCE_URL=                  # 如 postgresql://gb_ro:PASSWORD@pgvector:5432/shop_agent
GROWTHBOOK_CACHE_FILE=/data/growthbook_features.json
GB_ENCRYPTION_KEY=                          # GB 容器加密 key（secret 注入）
GB_JWT_SECRET=                              # GB 容器 JWT secret（secret 注入）
GROWTHBOOK_VERSION=v3.4.0                   # GB 稳定镜像 tag
MONGO_VERSION=7                             # mongo 稳定版本
