{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Launch shop-agent (local, connect k8s)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.k8s",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Launch shop-agent (local, all localhost)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Attach to k8s shop-agent (debug pod)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/apps/shop-agent",
                    "remoteRoot": "/code"
                }
            ],
            "justMyCode": false
        },
        {
            "name": "Python: Attach to Docker Desktop (local)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/apps/shop-agent",
                    "remoteRoot": "/code"
                }
            ],
            "justMyCode": false
        }
    ]
}
