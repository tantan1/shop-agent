# ── MCP Client（shop-agent 作为 MCP Client 消费远程 MCP Server，如 order-service）──
# 设为 true 后，ToolService 会在本地 Skill 之前优先尝试通过 MCP 协议调用远程工具。
MCP_CLIENT_ENABLED=false

# 远程 MCP Server 列表（JSON 数组）。order-service 已提供 read-only MCP 工具：
#   query-order / get-evidence / list-coupons（基于 rmcp 3.1.4 streamable-http）
# 每个元素字段：
#   name        : 服务逻辑名（用于日志 / 优先级排序）
#   url         : Streamable HTTP 端点（order-service 默认 /mcp）
#   headers     : 可选，附加请求头（鉴权 / tenant 等），键名随意
#   enabled     : 是否启用该服务
MCP_CLIENT_SERVERS=[
  {
    "name": "order-service",
    "url": "http://localhost:8081/mcp",
    "headers": {},
    "enabled": true
  }
]

# 优先级顺序：高优先级的服务在工具重名时优先被选为调用目标。
# 留空表示按 MCP_CLIENT_SERVERS 中数组顺序。
MCP_CLIENT_PRIORITY=["order-service"]
