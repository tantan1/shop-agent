# ── Langfuse 只读拉取(Web 薄层作为输入源,§2/§3)──
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 本地 SQLite:标注真值 / 去重 / 用户信号(§2.3,Option A)──
ANNOTATOR_SQLITE_DB=./annotations_idx.db

# ── 复检规模化:置信度边际闸门(§5.3)──
AUTO_PASS_MARGIN=0.15            # margin = top1_conf - top2_conf >= 此值 → 自动银标
AUTO_SPOTCHECK_RATE=0.08         # 自动放行样本中抽 8% 进人工队列做抽样复核
SPOTCHECK_PRECISION_FLOOR=0.95   # 抽样一致率低于此值 → 告警并收紧闸门

# ── 预标注(§2.4,可选;不配则前端不显示预填)──
# 指向 shop-agent 网关的 /agent/prelabel(需自行在 shop-agent 暴露),或留空
SHOP_AGENT_PRELABEL_URL=

# ── 服务 ──
HOST=0.0.0.0
PORT=8137
PAGE_SIZE=20
